{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "types": ["@types/mocha", "@types/assert"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "./dist/**/*",
    "./node_modules"
  ],
  "ts-node": { "esm": true },

}