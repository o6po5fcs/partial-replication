    "bench:shard-add-migration": "node --max-old-space-size-percentage=90 ./dist/2026-poltree-paper/naive-vs-poltree-sharding/benchShardAddMigration.js",
    "bench:shard-remove-migration": "node --max-old-space-size-percentage=90 ./dist/2026-poltree-paper/naive-vs-poltree-sharding/benchShardRemoveMigration.js"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@blazediff/object": "1.8.0",
    "securemerge": "file:../securemerge",
    "commander": "14.0.3",
    "fast-check": "4.6.0"
  }
}
