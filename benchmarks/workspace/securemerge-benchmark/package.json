{
  "name": "securemerge-benchmark",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "types": "./dist/mod.d.ts",
  "module": "./dist/mod.js",
  "exports": {
    ".": {
      "types": "./dist/src/mod.d.ts",
      "import": "./dist/src/mod.js",
      "default": "./dist/src/mod.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "bench:coverage": "node --max-old-space-size-percentage=90 ./dist/2026-poltree-paper/benchSecurityPolicyCoverage.js",
